      "parameters": {
        "jsCode": "const jsonData = $json;\n\nif (jsonData && jsonData.messages && jsonData.messages.length > 0) {\n    const message = jsonData.messages[0];\n\n    let textMessage = null;\n    let audioMessage = null;\n\n    if (message.type === \"text\") {\n        textMessage = message.text.body;\n    } else if (message.type === \"audio\") {\n        audioMessage = message.audio.url || null;\n    }\n   \n    return [\n        {\n            json: {\n                \"text\": textMessage,\n                \"audio\": audioMessage\n            }\n        }\n    ];\n} else {\n    return [\n        {\n            json: {\n                \"text\": null,\n                \"audio\": null\n            }\n        }\n    ];\n}\n"
      },
